package learning.SeleniumFramework.stepDefinitions.ui;

import org.openqa.selenium.WebDriver;

import io.cucumber.java.en.Given;
import io.cucumber.java.en.Then;
import io.cucumber.java.en.When;
import learning.SeleniumFramework.pageObjects.PDPPage;
import learning.SeleniumFramework.pageObjects.PageObjectManager;
import learning.SeleniumFramework.utils.TestContextSetup;

public class PDPUISteps {

	public WebDriver driver;
	public PDPPage pdpPage;
	TestContextSetup testContextSetup;
	PageObjectManager pageObjectManager;
	
	
	public PDPUISteps(TestContextSetup testContextSetup) {
		this.testContextSetup = testContextSetup;
		pdpPage = testContextSetup.pageObjectManager.getPDPPage();
	}

	
	@When("I search for product {string} and add to cart")
	public void i_search_for_product_and_add_to_cart(String productName){
		pdpPage.searchAndAddProduct(productName);
		
	}
	
	@Then("I navigate to Cart page")
	public void i_navigate_to_Cart_page() {
		
		pdpPage.moveToCart();
	}

	
}
